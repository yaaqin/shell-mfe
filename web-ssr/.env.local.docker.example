# Used by docker-compose (web-ssr/.env.local.docker) — copy this file to
# web-ssr/.env.local.docker before `docker compose up`.
# "backend" here is the Docker Compose service name, not localhost — this
# call happens server-to-server inside the compose network, never from the
# browser, so it doesn't need to be a public URL.
API_URL=http://backend:9761
