# Server-side only (never exposed to the browser) — used by Route Handlers
# and Server Components running on the Next.js server to call the API.
API_URL=http://localhost:9761

# web-ssr has no login form of its own — unauthenticated visitors are sent
# here to sign in on the CSR app, which then hands the session back via
# /api/auth/callback.
CSR_APP_URL=http://localhost:9762
