# Server
PORT=9761

# Postgres — the existing project DB. This backend is READ-ONLY against it
# (see PrismaService's read-only guard) — auth just SELECTs from `admins`.
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# JWT — tokens are stateless (no DB-backed session/refresh-token table),
# so a refresh always succeeds until the JWT itself expires; there is no
# server-side revocation.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend origins allowed to call this API (comma separated)
CORS_ORIGINS="http://localhost:9760,http://localhost:9762,http://localhost:9763"
