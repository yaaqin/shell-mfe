# Used by docker-compose (backend/.env.docker) — copy this file to
# backend/.env.docker and fill in real values before `docker compose up`.
# Differs from .env.example only in CORS_ORIGINS, which must be the
# public domain the gateway is served on, not localhost ports.

PORT=9761

# Postgres — existing project DB. Backend is READ-ONLY against it.
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# JWT — stateless tokens, no DB-backed session table
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Public origin(s) allowed to call this API — the gateway's public domain.
# web-ssr calls this container-to-container (no browser CORS involved), so
# it doesn't need to be listed here; web-csr's browser-side fetch does.
CORS_ORIGINS="https://shell.yaaqin.xyz"
