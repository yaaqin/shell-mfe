# Used by docker-compose.yml itself (root .env — docker compose loads this
# automatically for ${VAR} substitution). Copy to .env before building.
#
# This is the ONE tricky value in the whole stack: web-csr is a
# client-rendered app, so this gets baked into the JS bundle at BUILD time
# (see web-csr/Dockerfile's ARG) and is what the *browser* calls directly —
# it must be a publicly reachable URL, not a Docker service name like
# "http://backend:9761". Point it at wherever backend ends up exposed
# (directly, or behind a real TLS reverse proxy/subdomain in production).
NEXT_PUBLIC_API_URL=https://shell.yaaqin.xyz:9761
